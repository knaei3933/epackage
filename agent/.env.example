# Supabase (service_role - office PC only, never commit real values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Print backend: windows_spooler (office default, official Brother driver)
#               | brother_ql_raw (explicit raw TCP 9100 fallback)
LABEL_PRINT_BACKEND=windows_spooler
LABEL_WINDOWS_PRINTER_NAME=Brother QL-820NWB USB Setup
# Label orientation: horizontal (default - text across 58.9mm roll width)
#                    | rotated (text along roll length, larger characters)
LABEL_ORIENTATION=horizontal
# Rotated mode: address font size in px (bigger = longer label)
# LABEL_ROT_ADDR_FONT=32

# Raw TCP fallback only (ignored by windows_spooler)
# LABEL_PRINTER_URL=tcp://192.168.0.25:9100
# LABEL_PRINTER_MODEL=QL-820NWB
# Optional: JP font override (defaults: Meiryo/YuGothic on Windows, Noto on Linux)
# LABEL_FONT_PATH=C:\Windows\Fonts\meiryo.ttc
